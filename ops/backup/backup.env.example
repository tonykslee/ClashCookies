# Copy to /etc/clashcookies/backup.env, make root-owned, and chmod 0600.
# Do not commit the populated file.
BACKUP_DATABASE_SERVICE=clashcookies_backup
BACKUP_PG_DUMP_PATH=/usr/lib/postgresql/17/bin/pg_dump
BACKUP_PG_SERVICEFILE=/etc/clashcookies/pg_service.conf
BACKUP_PGPASSFILE=/etc/clashcookies/.pgpass
BACKUP_STAGING_DIR=/var/lib/clashcookies-backup

BACKUP_B2_BUCKET=clashcookies-prod-backups
BACKUP_B2_ENDPOINT=https://s3.<region>.backblazeb2.com
BACKUP_B2_PREFIX=clashcookies-prod
AWS_ACCESS_KEY_ID=replace-with-bucket-scoped-key-id
AWS_SECRET_ACCESS_KEY=replace-with-bucket-scoped-key
AWS_DEFAULT_REGION=us-east-1

BACKUP_AGE_RECIPIENT_PRIMARY=age1replace-with-primary-recipient
BACKUP_AGE_RECIPIENT_EMERGENCY=age1replace-with-emergency-recipient

# These endpoints receive only backup_id, event, and object_count.
BACKUP_HEARTBEAT_URL=https://monitor.example.invalid/backup-success
BACKUP_FAILURE_ALERT_URL=https://monitor.example.invalid/backup-failure

# Sunday and the first calendar day of each month are the long-retention copies.
BACKUP_WEEKLY_UTC_DAY=0
BACKUP_MONTHLY_UTC_DAY=1
BACKUP_MAX_ATTEMPTS=3
